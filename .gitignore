# 运行/打包产物
.venv/
build/
dist/
__pycache__/
*.pyc
.sim/
_*.log
_*.png
_*.txt

# 单文件打包的产物与中间目录（体积上百 MB，绝不入库）
dist-onefile/
build-onefile/
dist-onefile-linux/
build-onefile-linux/
dist-onefile-headless/
build-onefile-headless/
dist-docker/

# 交付归集目录（make-bundle.ps1 的产物，约 490 MB，绝不入库）
dist-all/

# Linux 构建用的独立虚拟环境
.venv-linux/

# 安卓构建专用的 Python 3.10 虚拟环境
# （Chaquopy 仓库在 android_24_arm64_v8a 上 opencv 只有 cp310，
#   所以安卓构建不能用主 .venv 的 3.13，见 android/app/build.gradle）
.venv310/

# 安卓构建产物
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
# sync-python.ps1 每次构建时从仓库根的 app/ 复制过来的镜像，不是源文件
android/app/src/main/python/
# numpy 的本地 wheel（android_24 无 cp310 版本，需要 android_21 的那份）
android/offline-wheels/
dist-android/
*.apk
*.aab
*.keystore
*.jks

# 测试与静态检查的缓存
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 编辑器
.vscode/
.idea/

# 安卓签名密钥：绝对不能入库（泄露等于任何人都能冒名发布更新）
.android-signing/
android/keystore.properties
android/*.jks
android/*.keystore
